# =============================================================================
# JUSTTECH Application Manager — environment variables
# Copy this file to `.env` in the repo root (docker-compose reads it) AND/OR
# `backend/.env` (the FastAPI app reads it directly when run outside Docker).
# Every variable below is either REQUIRED or explicitly marked optional.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# Local docker-compose Postgres (matches docker-compose.yml defaults):
DATABASE_URL=postgresql+asyncpg://justtech:justtech@localhost:5432/justtech
# If instead using a hosted Supabase project, use the "Connection Pooling"
# URI from Project Settings -> Database, with `+asyncpg` inserted after
# `postgresql`, e.g.:
#   postgresql+asyncpg://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Security (REQUIRED before storing any credentials) ---------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up outside git. Losing it makes stored site credentials
# permanently undecryptable.
JUSTTECH_ENCRYPTION_KEY=

# --- App behavior -------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
STORAGE_ROOT=./storage
DEFAULT_DRY_RUN=true
ENABLE_LOCAL_BROWSER_WORKER=true
INGESTION_INTERVAL_MINUTES=60

# --- n8n integration ----------------------------------------------------------
# REQUIRED to accept inbound webhooks at /api/webhooks/n8n/opportunity.
# Generate any long random string, e.g.: openssl rand -hex 32
N8N_WEBHOOK_SHARED_SECRET=
# OPTIONAL: n8n "Webhook" trigger node URL this app POSTs notifications to
# when a new opportunity scores >= 70 (auto-"qualified").
N8N_OUTBOUND_WEBHOOK_URL=

# --- Email alert ingestion (OPTIONAL — only if you configure an "email" ingestion source) ---
# Manual setup: create an app password for your mail provider (Gmail: Google
# Account -> Security -> App passwords) rather than using your real password.
JUSTTECH_ALERT_EMAIL_USERNAME=
JUSTTECH_ALERT_EMAIL_APP_PASSWORD=

# --- Frontend (Vite reads this at dev-server/build time, not from this file
# directly — copy the relevant line into frontend/.env) ----------------------
VITE_API_BASE_URL=http://localhost:8000
