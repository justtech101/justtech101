# =============================================================================
# freeflow-core — environment variables
# Copy to `.env` (never commit it) or set these in the Render/Railway dashboard.
# Every secret lives ONLY here. Business facts live in config/business.json.
# =============================================================================

# --- Channel ------------------------------------------------------------------
# "google_voice" (start here): co-pilot mode on your existing Google Voice number.
#   The service reads Google Voice's notification emails and emails you a draft of
#   every text, which you send from the Voice app. No Twilio needed. Calls go to Voice
#   voicemail; there is no AI phone receptionist in this mode.
# "twilio": fully automated on a Twilio number (texts send themselves, AI answers calls).
CHANNEL=google_voice

# --- Google Voice mode (REQUIRED when CHANNEL=google_voice) -----------------
# OAuth client from Google Cloud Console (type "Desktop app"). See README "Google Voice mode".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# From `npm run gmail -- auth` (run on your own computer).
GMAIL_REFRESH_TOKEN=
# The Gmail address that receives your Google Voice notifications.
GMAIL_ADDRESS=
# Where drafts/alerts/summaries go (defaults to GMAIL_ADDRESS).
OWNER_ALERT_EMAIL=
# Your Google Voice number (E.164), e.g. +18033806153.
GOOGLE_VOICE_NUMBER=
# Signs the one-tap links in your emails. Generate with: openssl rand -hex 32
ACTION_SECRET=
# How often to check Gmail for new Google Voice emails.
GV_POLL_SECONDS=20

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# The public HTTPS base URL Twilio calls (no trailing slash). Used to build
# webhook/callback URLs and to verify Twilio request signatures.
PUBLIC_BASE_URL=https://your-service.onrender.com
# "staging" or "production" — shown in alerts so test traffic is obvious.
DEPLOY_ENV=staging

# --- Database (REQUIRED) -----------------------------------------------------
# Hosted Postgres (Neon / Supabase / Render). Include ?sslmode=require for hosted.
DATABASE_URL=postgresql://freeflow:freeflow@localhost:5432/freeflow
# Set to "true" for hosted databases that need TLS but use a managed cert.
DATABASE_SSL=false

# --- Twilio (REQUIRED when CHANNEL=twilio) ------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The business number this deployment answers (E.164, e.g. +17065550100).
# Staging deployment = staging number; production deployment = live number.
TWILIO_PHONE_NUMBER=
# Leave true. Only set false for local development without Twilio.
TWILIO_VALIDATE_SIGNATURES=true

# --- Owner (REQUIRED when CHANNEL=twilio) -------------------------------------
# Jesse's mobile: receives every alert and can break into any thread by texting
# the business number from it.
OWNER_ALERT_NUMBER=
# OPTIONAL: number to ring first on inbound calls (usually the same mobile).
# Leave empty to have the receptionist answer every call directly.
OWNER_FORWARD_NUMBER=

# --- AI layer (REQUIRED) -----------------------------------------------------
ANTHROPIC_API_KEY=
# OPTIONAL override; defaults to claude-opus-5-5.
AI_MODEL=
# Set to "true" to deliberately disable the AI layer (acceptance test: the
# caller must reach voicemail, never silence).
AI_DISABLED=false

# --- Admin access (REQUIRED) -------------------------------------------------
# Bearer token for the /admin and /leads HTTP endpoints. Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=

# --- Daily summary email (OPTIONAL — SMS summary is always sent) ------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUMMARY_EMAIL_FROM=
SUMMARY_EMAIL_TO=

# --- Scheduler ----------------------------------------------------------------
# How often the job poller checks the jobs table. 60s keeps the 2-minute
# summary and 15-minute callback reminder on time.
JOB_POLL_SECONDS=60
# Staging acceptance tests only: run follow-up offsets in minutes instead of
# hours (+2h -> +2min, +1 day -> +24min, ...). Never set in production.
FOLLOWUP_ACCELERATED=false
