# ---- Gateway ----
PORT=3000

# ---- Chatwoot (required) ----
# Your self-hosted Chatwoot base URL, no trailing slash.
CHATWOOT_URL=https://chatwoot.yourdomain.com
CHATWOOT_ACCOUNT_ID=1
# Profile Settings > Access Token (use a dedicated bot agent).
CHATWOOT_API_TOKEN=your_chatwoot_access_token
# Optional: shared secret configured on the Chatwoot webhook.
CHATWOOT_WEBHOOK_SECRET=

# One API inbox per platform (Inboxes > Add Inbox > API). Numeric ids.
CHATWOOT_INBOX_DISCORD=
CHATWOOT_INBOX_TWITCH=
CHATWOOT_INBOX_INSTAGRAM=
CHATWOOT_INBOX_TIKTOK=

# ---- Discord (works out of the box) ----
# Developer Portal > your app > Bot > Token. Enable the "Message Content" intent.
DISCORD_BOT_TOKEN=

# ---- Twitch (channel chat) ----
TWITCH_BOT_USERNAME=
# Format: oauth:xxxxxxxx  (https://twitchtokengenerator.com or twitch CLI)
TWITCH_OAUTH_TOKEN=
# Comma-separated channels to join, e.g. mychannel,secondchannel
TWITCH_CHANNELS=

# ---- Instagram (needs Meta app review) ----
IG_PAGE_ACCESS_TOKEN=
IG_VERIFY_TOKEN=choose_any_string
IG_GRAPH_VERSION=v21.0

# ---- TikTok (no public DM API — see connectors/tiktok.js) ----
# Shared secret guarding the inbound bridge webhook.
TIKTOK_INBOUND_SECRET=
# Optional partner/bridge URL for sending replies back out.
TIKTOK_OUTBOUND_URL=
TIKTOK_OUTBOUND_TOKEN=

# ---- Escalations (optional) ----
# A Slack/Discord/webhook URL that gets a ping on refund/legal/chargeback.
ESCALATION_WEBHOOK_URL=
